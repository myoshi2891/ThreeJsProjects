# =============================================================================
# Hope Project - Development Dockerfile
# =============================================================================
# ベースイメージ: Bun 1.3.9 (Debian)
# 用途: ホットリロード対応の開発環境
# =============================================================================

FROM oven/bun:1.3.9-debian

# セキュリティ: 非rootユーザーで実行
RUN groupadd -g 1001 nodejs && \
    useradd -r -u 1001 -g nodejs vite

# gosuのインストール（ルート権限での実行時にユーザー切り替えを行うため）
# wget, ca-certificatesはヘルスチェック用
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget=1.21.3-1+b1 \
    ca-certificates=20230311 \
    gosu=1.14-1+b6 && \
    rm -rf /var/lib/apt/lists/*

# 作業ディレクトリ設定
WORKDIR /app

# viteユーザーに所有権を付与
RUN chown -R vite:nodejs /app

# 依存関係ファイルをコピー（キャッシュ効率化）
COPY --chown=vite:nodejs package.json ./
COPY --chown=vite:nodejs bun.lock* ./

# 依存関係インストール（イメージキャッシュ用）
# node_modulesの権限問題を回避するためviteユーザーで実行
USER vite
RUN bun install
USER root

# エントリーポイントスクリプトをコピー
COPY --chown=vite:nodejs docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# ソースコードはボリュームマウントで提供されるため、ここではコピーしない

# Vite開発サーバーのポート
EXPOSE 5173

# ヘルスチェック（viteユーザーで実行するためgosuを使用）
# NOTE: エントリーポイントの動作上、コンテナの実行ユーザーはrootである必要があるため、
# gosuを使って明示的にviteユーザーでヘルスチェックを実行します。
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD gosu vite wget --no-verbose --tries=1 --spider http://localhost:5173 || exit 1

# エントリーポイント設定（rootで実行され、内部でviteユーザーに切り替え）
ENTRYPOINT ["docker-entrypoint.sh"]

# 開発サーバー起動（host設定はvite.config.tsで管理）
CMD ["bun", "run", "dev"]
